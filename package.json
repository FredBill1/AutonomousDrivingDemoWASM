{
  "name": "autonomous-driving-demo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build wasm-core --target web --out-dir pkg --release",
    "check:wasm": "cargo test --manifest-path wasm-core/Cargo.toml",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc && vite build",
    "preview": "vite preview",
    "lint:ts": "eslint src/",
    "lint:rs": "cargo clippy --manifest-path wasm-core/Cargo.toml --all-targets -- -D warnings",
    "format:ts": "prettier --write src/",
    "format:rs": "cargo fmt --manifest-path wasm-core/Cargo.toml",
    "check:lengths": "node scripts/check-file-lengths.mjs",
    "check:duplication:ts": "jscpd ./src --format typescript",
    "check:duplication:tsx": "jscpd ./src --format tsx",
    "check:duplication:rs": "jscpd ./wasm-core/src --format rust",
    "check:format:ts": "prettier --check src/",
    "check:format:rs": "cargo fmt --manifest-path wasm-core/Cargo.toml --check",
    "check": "node scripts/run-checks.mjs"
  },
  "dependencies": {
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jscpd": "^4.0.5",
    "prettier": "^3.5.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.1.5"
  }
}